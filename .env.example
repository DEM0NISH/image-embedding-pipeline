# Environment Variables — copy this file to `.env` and fill in your values.
# NEVER commit a populated `.env` file to version control.

# ─── AWS ─────────────────────────────────────────────────────────────────────
# Option A: CLI profile (run `aws configure` — no env vars needed)
# Option B: explicit keys (not recommended for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── Pinecone ────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=image-embeddings
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_S3_BUCKET=your-s3-bucket-for-mlflow-artifacts
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Pipeline Runtime (populated after `terraform apply`) ────────────────────
DEAD_LETTER_BUCKET=
RAW_BUCKET_NAME=
STEP_FUNCTIONS_ARN=
EMR_CLUSTER_ID=
SPARK_SCRIPT_S3_PATH=

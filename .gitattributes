# Ensure consistent line endings across platforms
* text=auto

# Force Unix line endings for scripts & configs
*.py     text eol=lf
*.sh     text eol=lf
*.tf     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.example text eol=lf

# Binary files — no line-ending conversion
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.tar    binary
*.gz     binary
*.zip    binary
